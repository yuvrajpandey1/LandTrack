{
  "name": "landtrack",
  "private": true,
  "version": "1.3.0",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "concurrently -k \"corepack pnpm --dir apps/api start:dev\" \"corepack pnpm --dir apps/web dev\"",
    "build": "corepack pnpm -r build",
    "lint": "corepack pnpm -r lint",
    "test": "corepack pnpm -r test"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.7.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
