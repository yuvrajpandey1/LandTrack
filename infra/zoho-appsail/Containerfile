FROM node:22-bookworm-slim

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates openssl postgresql redis-server gosu clamav clamav-daemon \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable \
    && corepack prepare pnpm@9.12.3 --activate

# Virus signatures are baked in at build time; clamd runs from /opt/clamdb as a non-root user.
RUN mkdir -p /opt/clamdb && chown clamav:clamav /opt/clamdb \
    && printf "DatabaseMirror database.clamav.net\nDatabaseDirectory /opt/clamdb\n" > /tmp/freshclam.conf \
    && gosu clamav freshclam --config-file=/tmp/freshclam.conf --no-warnings \
    && chmod -R a+rX /opt/clamdb

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps apps
COPY packages packages

ENV CONTAINER_BUILD=true

RUN pnpm install --frozen-lockfile \
    && DATABASE_URL=postgresql://u:p@127.0.0.1:5432/build pnpm --dir apps/api build \
    && API_URL=http://127.0.0.1:4000 pnpm --dir apps/web build

COPY infra/zoho-appsail infra/zoho-appsail
COPY infra/zoho-appsail/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

USER node
ENV NODE_ENV=production
EXPOSE 9000

CMD ["/entrypoint.sh"]
